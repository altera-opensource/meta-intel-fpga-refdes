From f1d55f9b6750c05b0dddeb06692281a9b84fe55f Mon Sep 17 00:00:00 2001
From: Naveen Saini <naveen.kumar.saini@intel.com>
Date: Mon, 17 Oct 2022 15:50:34 +0800
Subject: [PATCH 2/2] Makefile: It does not detect libbpf header from sysroot

So adding sysroot headers path.

Upstream-Status: Pending

Signed-off-by: Naveen Saini <naveen.kumar.saini@intel.com>
---
 lib/common.mk       | 2 +-
 lib/libxdp/Makefile | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/lib/common.mk b/lib/common.mk
index dfac249..a3ec479 100644
--- a/lib/common.mk
+++ b/lib/common.mk
@@ -58,7 +58,7 @@ LIBXDP_SOURCES := $(wildcard $(LIBXDP_DIR)/*.[ch] $(LIBXDP_DIR)/*.in)
 KERN_USER_H ?= $(wildcard common_kern_user.h)
 
 CFLAGS += -I$(HEADER_DIR) -I$(LIB_DIR)/util $(ARCH_INCLUDES)
-BPF_CFLAGS += -I$(HEADER_DIR) $(ARCH_INCLUDES)
+BPF_CFLAGS += -I$(HEADER_DIR) $(ARCH_INCLUDES) -I${STAGING_INCDIR}/
 
 BPF_HEADERS := $(wildcard $(HEADER_DIR)/bpf/*.h) $(wildcard $(HEADER_DIR)/xdp/*.h)
 
diff --git a/lib/libxdp/Makefile b/lib/libxdp/Makefile
index c3336f2..337c255 100644
--- a/lib/libxdp/Makefile
+++ b/lib/libxdp/Makefile
@@ -29,6 +29,7 @@ TEMPLATED_SOURCES := xdp-dispatcher.c
 
 CFLAGS += -I$(HEADER_DIR)
 BPF_CFLAGS += -I$(HEADER_DIR) $(ARCH_INCLUDES)
+BPF_CFLAGS += -I$(HEADER_DIR) $(ARCH_INCLUDES) -I${STAGING_INCDIR}/
 
 
 ifndef BUILD_STATIC_ONLY
-- 
2.25.1

